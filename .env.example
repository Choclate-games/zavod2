# AI Game Prompt Factory Configuration
# Provider settings: 'local', 'agy' (Antigravity CLI), 'opencode' (OpenCode Go / Zen API), 'openai', 'anthropic', 'google'
DEFAULT_PROVIDER=local
# Превью игр: 'qwen' (DashScope, самый дешёвый), 'agy', 'openai', 'local', 'none'
IMAGE_PROVIDER=qwen

# Qwen / DashScope (международный регион) — генерация концепт-превью.
# Ключ берётся на dashscope.console.aliyun.com, модель wan2.2-t2i-flash самая дешёвая.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com
QWEN_IMAGE_MODEL=wan2.2-t2i-flash

# Antigravity CLI Settings (uses local agy executable)
AGY_CLI_PATH=agy
AGY_MODEL=
# Пусто = не передавать --effort. Флаг принимают только некоторые модели,
# и только вместе с явно заданным AGY_MODEL.
AGY_EFFORT=

# Терминальные кодовые агенты кроме AGY: Claude Code, OpenAI Codex, Kimi CLI.
# DEFAULT_AGENT — агент по умолчанию во вкладке чатов: agy | claude | codex | kimi
DEFAULT_AGENT=agy

CLAUDE_CLI_PATH=claude
CLAUDE_MODEL=
# Список моделей для выпадающего списка (через запятую); пусто = встроенный набор
CLAUDE_MODELS=
# Доп. аргументы запуска, если у вашей версии CLI другие флаги
CLAUDE_EXTRA_ARGS=

CODEX_CLI_PATH=codex
CODEX_MODEL=
CODEX_MODELS=
CODEX_EXTRA_ARGS=

KIMI_CLI_PATH=kimi
KIMI_MODEL=
KIMI_MODELS=
KIMI_EXTRA_ARGS=
# Флаг неинтерактивного режима Kimi Code CLI (по умолчанию -p)
KIMI_PRINT_FLAG=-p

# Ориентировочные лимиты для вкладки «Квоты»: у этих CLI нет машинного отчёта
# об остатке, поэтому фабрика считает свои запуски за 5 часов и за неделю.
CLAUDE_LIMIT_5H=50
CLAUDE_LIMIT_WEEKLY=500
CODEX_LIMIT_5H=50
CODEX_LIMIT_WEEKLY=500
KIMI_LIMIT_5H=100
KIMI_LIMIT_WEEKLY=1000

# OpenCode Go / Zen Subscription API Settings
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=opencode-zen

# OpenAI API Key (optional, if using provider=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3

# Anthropic API Key (optional, if using provider=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini API Key (optional, if using provider=google)
GEMINI_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# Каталог проектов и песочница кодового агента.
# Все игры создаются в WORKSPACE_DIR/<slug>/, агенту доступен только он.
WORKSPACE_DIR=workspace
OUTPUT_DIR=workspace
DEFAULT_MODE=standard
GUI_HOST=127.0.0.1
GUI_PORT=7860

# Уведомления Windows о завершении задач в чатах (1 — включены, 0 — выключены).
# Переключается галочкой «🔔 Уведомления» в чате и на вкладке настроек.
NOTIFICATIONS_ENABLED=1
