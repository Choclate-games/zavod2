# Provider settings: 'opencode', 'agy' (Antigravity CLI), 'claude', 'codex'
# (kimi отключён — см. providers/cli_agents.AGENT_CLASSES)
DEFAULT_PROVIDER=opencode
ALLOW_TEMPLATE_MIXING=0
# Превью игр: 'qwen' (DashScope, самый дешёвый), 'agy', 'none'
IMAGE_PROVIDER=qwen

# Qwen / DashScope (международный регион) — генерация концепт-превью.
# Ключ берётся на dashscope.console.aliyun.com, модель wan2.2-t2i-flash самая дешёвая.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com
QWEN_IMAGE_MODEL=wan2.2-t2i-flash

# Antigravity CLI Settings (uses local agy executable)
# Остаток квот фабрика читает у самого Antigravity: и IDE, и запущенный agy.exe
# держат локальный Connect-RPC (RetrieveUserQuotaSummary) — оттуда берутся те же
# недельное и пятичасовое окна, что печатает /usage в самом agy. Пока ни то, ни другое не
# запущено, показывается последний снимок; выдуманных процентов больше нет.
# Полосы по числу запросов можно включить, задав лимит своего тарифа вручную:
# AGY_LIMIT_5H_GEMINI / AGY_LIMIT_WEEKLY_GEMINI и то же для CLAUDE.
AGY_CLI_PATH=agy
AGY_MODEL=
# Пусто = не передавать --effort. Флаг принимают только некоторые модели,
# и только вместе с явно заданным AGY_MODEL.
AGY_EFFORT=

# Терминальные кодовые агенты кроме AGY: Claude Code, OpenAI Codex, OpenCode.
# DEFAULT_AGENT — агент по умолчанию во вкладке чатов: agy | claude | codex | opencode
DEFAULT_AGENT=agy

# Сторож зависаний (общий для всех терминальных агентов). Сейчас выключен:
# долгая задача имеет право молчать, а снять её всегда можно кнопкой «Стоп».
# AGENT_IDLE_TIMEOUT_SECONDS — столько секунд без единой строки вывода считаются
# зависанием: процесс агента и все его потомки снимаются, задача помечается
# неудачной. 0 — не обрывать никогда. Чтобы включить, впишите, например, 900.
AGENT_IDLE_TIMEOUT_SECONDS=0
# AGENT_IDLE_PING_SECONDS — как часто писать в ленту «агент молчит N с», чтобы
# работающий агент отличался от зависшего. 0 — не писать (по умолчанию 60).
AGENT_IDLE_PING_SECONDS=60

CLAUDE_CLI_PATH=claude
CLAUDE_MODEL=
# Список моделей для выпадающего списка (через запятую); пусто = встроенный набор
CLAUDE_MODELS=
# Доп. аргументы запуска, если у вашей версии CLI другие флаги
CLAUDE_EXTRA_ARGS=

CODEX_CLI_PATH=codex
CODEX_MODEL=
CODEX_MODELS=
CODEX_EXTRA_ARGS=

# Kimi отключён: агент убран из AGENT_CLASSES, переменные оставлены на случай
# возврата (раскомментировать строку в providers/cli_agents.py и AGENT_LABELS).
# KIMI_CLI_PATH=kimi
# KIMI_MODEL=
# KIMI_MODELS=
# KIMI_EXTRA_ARGS=
# KIMI_PRINT_FLAG=-p

# Лимиты для вкладки «Квоты». Claude Code и Codex публикуют реальный остаток
# сами (фабрика читает ~/.claude.json и ~/.codex/sessions), задавать ничего не
# нужно. У OpenCode остатка на диске нет вовсе — он виден только в личном
# кабинете, поэтому фабрика показывает свой расход и ссылку туда. Впишите лимит
# своего тарифа — вместо счётчика запусков появятся полосы остатка.
OPENCODE_LIMIT_5H=
OPENCODE_LIMIT_WEEKLY=
# Куда ведёт кнопка «Открыть личный кабинет» на вкладке квот.
OPENCODE_CONSOLE_URL=https://opencode.ai/auth

# OpenCode Go / Zen Subscription API Settings
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=opencode-zen

# OpenAI API Key (optional, if using provider=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3

# Anthropic API Key (optional, if using provider=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini API Key (optional, if using provider=google)
GEMINI_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# Каталог проектов и песочница кодового агента.
# Все игры создаются в WORKSPACE_DIR/<slug>/, агенту доступен только он.
WORKSPACE_DIR=workspace
OUTPUT_DIR=workspace
# Куда складывать упакованные игры. Отдельно от workspace: туда ходит кодовый
# агент, и архивам соседних проектов там не место. См. app/archive.py.
ARCHIVE_DIR=zip_projects
# Общее хранилище node-пакетов (pnpm-стор + кеш загрузок). Обязано лежать на том
# же диске, что и WORKSPACE_DIR: иначе жёсткие ссылки не работают и каждая игра
# снова получит свою полную копию node_modules. См. app/pkgstore.py.
PKG_STORE_DIR=.pkgstore
# Потолок для истории отката (снимки перед каждой задачей агенту, app/snapshots.py).
# Когда снимки всех игр вместе перевалят за него, фабрика ужимает их, а если этого
# мало — выбрасывает историю самых старых игр целиком. 0 — не ограничивать.
SNAPSHOT_LIMIT_MB=1024
DEFAULT_MODE=standard

# ── Мост площадки ───────────────────────────────────────────────────────────
# Откуда игры ставят Playgama Bridge. По умолчанию — релиз форка студии из
# config/playgama.yaml: в реестре npm лежит апстримовский пакет, в котором нет
# ни настоящей авторизации VK, ни платежей через VKWebAppShowOrderBox, ни OK
# поверх VK Bridge, ни GameMonetize, ни Android, ни экрана загрузки студии.
# Заполняйте, чтобы поднять версию форка, не трогая yaml. Имя пакета менять
# незачем — у форка оно то же самое, и импорты в играх не меняются.
BRIDGE_PACKAGE_SOURCE=
BRIDGE_PACKAGE_NAME=

# ── Прогон игры на площадке Яндекса ─────────────────────────────────────────
# Последняя фаза сборки: игру открывают так, как её откроет игрок — с SDK
# Яндекса, в полутора десятках разрешений, с чтением bridge.storage до и после
# перезагрузки. Гоняет это тестер студии (репозиторий AI_Tester), который
# фабрика клонирует себе сама в tools/gametest при первом прогоне.
# Всё это правится и на экране «⚙️ Настройки» — здесь для тех, кто держит
# конфигурацию в файле.
GAMETEST_ENABLED=1
# Репозиторий приватный: нужен токен. Пусто — берётся ZAVOD_KNOWLEDGE_TOKEN,
# затем GITHUB_TOKEN.
GAMETEST_TOKEN=
GAMETEST_REPO=Choclate-games/AI_Tester
# Ветка тестера. Фабрике нужны `auth-status`, `run --run-json` и
# `auth --no-prompt`: без них она не может ни спросить о сессии, ни найти
# отчёт, ни открыть окно входа без терминала. Слишком старый тестер фабрика
# распознаёт до прогона и говорит, чего именно в нём нет.
GAMETEST_REF=main
GAMETEST_DIR=
# Обновлять тестер перед каждым прогоном. Выключено: молчаливое обновление
# инструмента посреди сборки меняет её результат без единой строчки в логе.
GAMETEST_UPDATE=0
GAMETEST_INSTALL_BROWSERS=1

# auto | dev | draft. draft — настоящая страница yandex.ru/games с черновиком:
# показывает игру ровно так, как её увидит игрок, но требует привязанного
# черновика (`python -m app.cli yandex-app-id <игра> <id>`) и входа в аккаунт
# (`yandex-login`). auto берёт draft, когда есть и то и другое, иначе dev.
GAMETEST_YANDEX_MODE=auto
# smoke — четыре ключевых разрешения, default — вся матрица (дольше в разы).
GAMETEST_VIEWPORTS=smoke
GAMETEST_ORIENTATION=both
GAMETEST_PROFILE=a
GAMETEST_JOBS=3
# Сколько играть перед проверкой сохранений: игры пишут прогресс по событиям
# геймплея, а не по таймеру на старте.
GAMETEST_PLAY_MS=45000
GAMETEST_TIMEOUT=2700
# Начиная с какой серьёзности находка валит приёмку: blocker | major | minor.
GAMETEST_BLOCK_ON=major
# Что проверять — через запятую. Пусто = набор по умолчанию (без рекламы и
# покупок: у свежей игры каталога в консоли площадки ещё нет).
GAMETEST_CHECKS=

# Вердикт по находкам выносит модель: порог в коде не знает контекста, а
# 40 px скролла на десктопе и на экране 320 px — разные новости.
GAMETEST_LLM_ENABLED=1
GAMETEST_LLM_PROVIDER=opencode
GAMETEST_LLM_MODEL=
GAMETEST_LLM_BASE_URL=
GAMETEST_LLM_KEY_ENV=LLM_API_KEY
LLM_API_KEY=
GUI_HOST=127.0.0.1
GUI_PORT=7860

# ── Вход в интерфейс ────────────────────────────────────────────────────────
# Фабрика запускает терминальных агентов и выполняет сгенерированный ими код.
# Открытый интерфейс — это удалённое выполнение кода на машине, где он крутится,
# поэтому вход включён по умолчанию.
#
# AUTH_ENABLED=0 допустимо ровно в одном случае: запуск на своей машине с
# GUI_HOST=127.0.0.1. Как только сервер слушает что-то кроме loopback (сервер,
# докер, VPN) — только 1.
AUTH_ENABLED=1
AUTH_USERNAME=admin
# Не пароль, а его хеш. Получить: python -m app.web.auth --hash
# Смена пароля автоматически разлогинивает все открытые сессии.
#
# Общее правило для всего этого файла: Docker Compose разворачивает `$` в
# значениях env_file. Если в каком-нибудь ключе окажется доллар, до контейнера
# доедет обрезанная строка, и compose лишь буркнет «variable is not set».
# Экранируется удвоением: `$$`. Хеш пароля от этого защищён — в нём двоеточия.
AUTH_PASSWORD_HASH=
# Сколько дней живёт сессия без повторного входа.
AUTH_SESSION_DAYS=30
# Включать ТОЛЬКО когда перед фабрикой стоит свой nginx: тогда счётчик неудачных
# входов берёт адрес из X-Forwarded-For. Без прокси заголовок подделывается кем
# угодно, и защита от перебора обходится одной строкой.
AUTH_TRUST_PROXY=0

# Сколько прогонов студии идут одновременно. Каждая идея — свой прогон со своим
# журналом и кнопкой «Стоп»; заказанные сверх лимита ждут очереди.
STUDIO_MAX_PARALLEL=10

# Уведомления Windows о завершении задач в чатах (1 — включены, 0 — выключены).
# Переключается галочкой «🔔 Уведомления» в чате и на вкладке настроек.
NOTIFICATIONS_ENABLED=1

# Каждый запуск игры «с чистого листа» (1 — включено, 0 — выключено).
# Перед стартом сносятся кеши сборщика (node_modules/.vite, dist, .cache…),
# Vite поднимается с --force, а dev-сервер получает новый порт. Новый порт —
# новый origin, а к origin привязан localStorage: игра открывается без
# прошлого прогресса и сохранений.
RESET_GAME_ON_LAUNCH=1

# Fish Audio — генерация голосов (TTS) во вкладке проекта «🔊 Озвучка».
# Ключ берётся на fish.audio → API Keys. Генерацию запускает только человек:
# агенты фабрики к TTS не обращаются.
# FISH_AUDIO_MODEL: s2.1-pro-free (бесплатная) | s2.1-pro | s2-pro | s1
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free

# Повторы вызова модели. Фабрика работает только онлайн, поэтому единичная
# осечка провайдера лечится повтором, а не подстановкой заготовки.
# Когда попытки кончились, прогон не падает, а приостанавливается: продолжить
# его можно командой `python -m app.cli continue <прогон>` (список — `runs`).
AGENT_RETRY_ATTEMPTS=3
AGENT_RETRY_BACKOFF_SECONDS=4

# ── База знаний в готовой игре ────────────────────────────────────────────
# Пакет игры не носит копии документации: он носит манифест
# (knowledge.manifest.json) и скрипт scripts/fetch-knowledge.mjs, который
# кладёт нужное в docs/ref/ одной командой.
#
# Токен обязателен, только если репозиторий базы приватный. Он передаётся
# кодовому агенту переменной окружения и НИКОГДА не пишется в папку игры:
# она уезжает в git вместе со всем содержимым.
KNOWLEDGE_REPO=EdikN/zavod2
KNOWLEDGE_REF=main
ZAVOD_KNOWLEDGE_TOKEN=

# ── MySQL ───────────────────────────────────────────────────────────────────
# Реестр витрины (оценка, архив, избранное, название), пользователи и журнал
# zip-архивов. Игры, чаты и снимки отката остаются на диске: база стоит за WAN,
# запрос к ней около ста миллисекунд, и держать на ней горячий путь нельзя.
#
# Выключено — фабрика работает по JSON, как раньше, и ничего не теряет.
MYSQL_ENABLED=0
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
# Знак `%` в пароле безопасен — DSN-строка не собирается. Знак `$` НЕ безопасен:
# Docker Compose разворачивает доллары в значениях env_file. Экранируется `$$`.
MYSQL_PASSWORD=
MYSQL_DB=
# Соединений в пуле. Больше трёх незачем: запросов мало, а шаред-хостинг
# ограничивает их число на пользователя.
MYSQL_POOL_SIZE=3
# Как часто пинговать простаивающие соединения. Должно быть меньше wait_timeout
# сервера (у Beget это 30 секунд), иначе каждый запрос после паузы платит
# полутора секундами на переподключение.
MYSQL_KEEPALIVE_SECONDS=20

# ── Автоархивы игр ──────────────────────────────────────────────────────────
# Агент отработал — игра упакована. Пакуются исходники без node_modules и без
# служебного .factory/; собранную версию по-прежнему делает кнопка на вкладке
# «Игра».
BUILD_ZIP_ENABLED=1
# Куда складывать. По умолчанию builds/ рядом с workspace. НЕ zip_projects/ —
# там наличие файла означает «игра убрана с диска» (app/archive.py).
BUILDS_DIR=
# Сколько архивов на игру хранить. 0 — не чистить.
BUILD_ZIP_KEEP=10
# Класть ли в базу содержимое архивов, снятых после прогона агента. По
# умолчанию нет: игра в этот момент лежит рядом на диске целиком, и копия не
# защищает ни от чего, а таких архивов за ночь набегают десятки.
BUILD_ZIP_TO_DB=0
BUILD_ZIP_DB_MAX_MB=32

# А вот игру, отправленную в архив, копировать в базу стоит: каталог удалён,
# zip остался единственным экземпляром. Возврат из архива копию убирает.
ARCHIVE_TO_DB=1
# Потолок для такой копии. Больше, чем у экспорта: тут игра целиком.
ARCHIVE_DB_MAX_MB=128

# ── Зеркало живых проектов ──────────────────────────────────────────────────
# Раз в час фабрика сверяет каждую игру с её копией в базе и обновляет копию,
# если на диске появилось что-то новее. Копия на игру ровно одна.
#
# Зачем: мини-ПК — это один SSD без всякого RAID, а игры, сделанные прямо на
# нём, в git не уезжают (фабрика не коммитит).
MYSQL_MIRROR=1
# Как часто сверять. Меньше пяти минут не даём — это WAN, а не локальный диск.
MYSQL_MIRROR_INTERVAL_SECONDS=3600
# Потолок на одну игру.
MYSQL_MIRROR_MAX_MB=64
# Общий бюджет зеркала. Дойдя до него, зеркало перестаёт брать НОВЫЕ игры, но
# продолжает обновлять уже взятые: замороженная копия месячной давности хуже
# её отсутствия, потому что выглядит как резервная. 0 — не ограничивать.
MYSQL_MIRROR_BUDGET_MB=512
# Размер куска заливки. Мельче max_allowed_packet сервера с большим запасом.
BUILD_ZIP_CHUNK_KB=1024

# Часовой пояс контейнера фабрики (используется compose.yml). Без него внутри
# UTC, и всё, что фабрика датирует сама — имена автоархивов, метки чатов, даты
# в реестре — расходится с часами пользователя.
TZ=Asia/Yekaterinburg
