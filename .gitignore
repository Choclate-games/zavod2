# =============================================================================
# Правило репозитория: код фабрики И сами игры (workspace/, output/) едут в git.
# Игнорируем только то, что пересоздаётся само: кеши, сборки, зависимости, логи.
# Поэтому пути к «питоновским» каталогам заякорены на корень (/build/, /dist/),
# чтобы одноимённые папки внутри игр обрабатывались своими правилами ниже.
# =============================================================================

# --- Python (только корень проекта фабрики) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Виртуальные окружения ---
venv/
.venv/
.venv-check/
ENV/
env/
env.bak/
venv.bak/

# --- Тесты, покрытие, статический анализ ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# --- Зависимости и сборки игр (в любом проекте на любой глубине) ---
node_modules/
bower_components/
.pnp/
.pnp.js
**/dist/
**/dist-ssr/
**/build/
**/out/
**/.vite/
**/.cache/
**/.parcel-cache/
**/.turbo/
**/.rollup.cache/
**/.next/
**/.nuxt/
**/.svelte-kit/
**/.vuepress/dist/
**/.serverless/
**/.fusebox/
**/.dynamodb/
**/storybook-static/
*.tsbuildinfo
**/coverage/
**/.eslintcache
**/.stylelintcache

# Артефакты выкладки игр на платформы
**/*.zip
**/*.tar.gz
**/*.7z
!**/assets/**/*.zip

# --- Capacitor / Android сборки внутри игр ---
**/android/build/
**/android/app/build/
**/android/.gradle/
**/android/local.properties
**/android/app/release/
**/ios/App/Pods/
**/ios/App/build/
*.apk
*.aab
*.keystore
*.jks

# --- Внутреннее состояние фабрики внутри проектов ---
# История чатов и служебные метки пересоздаются и часто конфликтуют при мерже.
**/.factory/
# Исключение: реестр проектов (рейтинг, архив, дата появления) — это данные
# пользователя, а не кеш. Без него после клона витрина теряет оценки и архив.
!workspace/.factory/
workspace/.factory/*
!workspace/.factory/projects.json
# Логи dev-сервера и превью-браузера
**/.dev-server.log

# --- Логи и временные файлы ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp
tmp/
temp/

# --- Секреты и переменные окружения ---
.env
.env.local
.env.*.local
*.env
!.env.example
*.pem
*.key
*.cert

# --- Редакторы и IDE ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# --- Операционная система ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Внутренняя история CLI-агентов ---
.agy_quota_history.json
.agy_quota_live.json
.agent_usage_history.json
.token_usage_totals.json
.agy/
.gemini/
.claude/
.codex/
.kimi/

# Загруженные копии базы знаний внутри пакетов игр. Игра носит манифест и
# скрипт загрузки; сами файлы приезжают локально и в репозиторий не едут —
# иначе мы вернулись бы к тем же копиям в каждом проекте, от которых уходили.
# (именно **/ — путь со слэшем внутри git привязывает к корню репозитория)
**/docs/ref/
