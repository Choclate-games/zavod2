# =============================================================================
# Правило репозитория: код фабрики И сами игры (workspace/, output/) едут в git.
# Игнорируем только то, что пересоздаётся само: кеши, сборки, зависимости, логи.
# Поэтому пути к «питоновским» каталогам заякорены на корень (/build/, /dist/),
# чтобы одноимённые папки внутри игр обрабатывались своими правилами ниже.
# =============================================================================

# --- Python (только корень проекта фабрики) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Виртуальные окружения ---
venv/
.venv/
.venv-check/
ENV/
env/
env.bak/
venv.bak/

# --- Тесты, покрытие, статический анализ ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Общее хранилище node-пакетов фабрики (app/pkgstore.py): стор pnpm, кеш
# загрузок и локально установленный pnpm. Всё восстановимо установкой.
.pkgstore/

# Настройки общего стора внутри игр — машинно-зависимые абсолютные пути.
**/pnpm-workspace.yaml
**/.npmrc

# --- Зависимости и сборки игр (в любом проекте на любой глубине) ---
node_modules/
bower_components/
.pnp/
.pnp.js
**/dist/
**/dist-ssr/
**/build/
**/out/
**/.vite/
**/.cache/
**/.parcel-cache/
**/.turbo/
**/.rollup.cache/
**/.next/
**/.nuxt/
**/.svelte-kit/
**/.vuepress/dist/
**/.serverless/
**/.fusebox/
**/.dynamodb/
**/storybook-static/
*.tsbuildinfo
**/coverage/
**/.eslintcache
**/.stylelintcache

# Артефакты выкладки игр на платформы
**/*.zip
**/*.tar.gz
**/*.7z
!**/assets/**/*.zip

# Упакованные игры (zip_projects/). Игра, которую убрали в архив, исчезает с
# диска — и, не будь этих строк, исчезла бы из git вместе с папкой, хотя
# правило репозитория (строка 2) требует обратного. Внутри архива тот же
# исходный код, без node_modules и сборок.
#
# Стоит ПОСЛЕ `**/*.zip` намеренно: из нескольких подходящих правил git
# применяет последнее, и выше эти строки не работали бы.
#
# Вместе с кодом внутрь архива едет и `.factory/` — чаты, вложения и история
# отката. Правило `**/.factory/` ниже держит их вне git у распакованных игр,
# а у упакованных они оказываются внутри zip. Это решено осознанно: переписка
# с агентом и возможность откатить запрос должны переживать упаковку, и терять
# их при переносе репозитория на другую машину незачем.
!zip_projects/
!zip_projects/*.zip
# Отметки времени обращения — состояние сборщика, а не данные пользователя.
zip_projects/access.json

# --- Capacitor / Android сборки внутри игр ---
**/android/build/
**/android/app/build/
**/android/.gradle/
**/android/local.properties
**/android/app/release/
**/ios/App/Pods/
**/ios/App/build/
*.apk
*.aab
*.keystore
*.jks

# --- Внутреннее состояние фабрики внутри проектов ---
# Отчёты приёмки, история отката и вложения пересоздаются или восстанавливаются
# и часто конфликтуют при мерже — в git они не едут.
#
# Каталог гасится по содержимому (`/*`), а не целиком (`/`): исключённый целиком
# каталог git даже не просматривает, и любые исключения внутри него ниже
# перестали бы работать.
**/.factory/*
# Исключение: переписка с агентом. Это работа пользователя, а не кеш. У
# упакованных игр чаты и так уезжают в git внутри zip — терять их у
# распакованных было бы несогласованно.
!**/.factory/chats/
# Исключение: реестр проектов (рейтинг, архив, дата появления) — это данные
# пользователя, а не кеш. Без него после клона витрина теряет оценки и архив.
!workspace/.factory/projects.json
# Логи dev-сервера и превью-браузера
**/.dev-server.log

