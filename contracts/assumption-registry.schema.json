{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-game-prompt-factory/contracts/assumption-registry.schema.json",
  "title": "Assumption Registry",
  "description": "Реестр допущений проекта с уровнем уверенности и опровергающим наблюдением.",
  "type": "object",
  "required": [
    "schema_version",
    "slug",
    "assumptions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "slug": {
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "category",
          "ul_level",
          "impact",
          "confidence",
          "validation_method",
          "falsifier",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A-[0-9]{2,}$"
          },
          "statement": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "design",
              "player",
              "market",
              "tech",
              "monetization",
              "platform"
            ]
          },
          "ul_level": {
            "type": "string",
            "enum": [
              "UL-L0",
              "UL-L1",
              "UL-L2",
              "UL-L3",
              "UL-L4",
              "UL-L5"
            ]
          },
          "impact": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "validation_method": {
            "type": "string"
          },
          "falsifier": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "validated",
              "refuted",
              "deferred"
            ]
          }
        }
      }
    }
  }
}
