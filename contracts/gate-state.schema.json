{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-game-prompt-factory/contracts/gate-state.schema.json",
  "title": "Human Gate State",
  "description": "Состояние человеческих ворот: где фабрика и кодовый агент обязаны остановиться.",
  "type": "object",
  "required": [
    "schema_version",
    "slug",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "slug": {
      "type": "string"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "question",
          "blocks",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^GATE-[0-9]{2,}$"
          },
          "name": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "blocks": {
            "type": "string"
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "rejected"
            ]
          },
          "decided_at": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
