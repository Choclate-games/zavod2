{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-game-prompt-factory/contracts/player-promise-contract.schema.json",
  "title": "Player Promise Contract",
  "description": "Обещание игроку по трём горизонтам: витрина платформы, первые 60 секунд, долгая игра.",
  "type": "object",
  "required": [
    "schema_version",
    "slug",
    "concept_title",
    "store_promise",
    "first_session_promise",
    "long_term_promise"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "slug": {
      "type": "string"
    },
    "concept_title": {
      "type": "string"
    },
    "store_promise": {
      "type": "object",
      "required": [
        "claim",
        "expected_evidence",
        "failure_signals"
      ],
      "properties": {
        "claim": {
          "type": "string"
        },
        "expected_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "first_session_promise": {
      "type": "object",
      "required": [
        "claim",
        "expected_evidence",
        "failure_signals"
      ],
      "properties": {
        "claim": {
          "type": "string"
        },
        "expected_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "long_term_promise": {
      "type": "object",
      "required": [
        "claim",
        "expected_evidence",
        "failure_signals"
      ],
      "properties": {
        "claim": {
          "type": "string"
        },
        "expected_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
