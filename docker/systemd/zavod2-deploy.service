# Развернуть новую версию руками, с самой машины:
#
#   sudo systemctl start zavod2-deploy && journalctl -u zavod2-deploy -f
#
# Обычный путь другой: job подключается по ssh и запускает тот же скрипт сам,
# показывая каждый его шаг в логе прогона. Этот юнит остаётся для случая, когда
# GitHub недоступен или надо развернуть, ничего не пушив.
#
# Парного zavod2-deploy.path больше нет: файл-триггер был односторонним
# сигналом, о результате которого никто не узнавал.

[Unit]
Description=Zavod2: пересобрать и перезапустить фабрику
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=oem
Group=oem
WorkingDirectory=/opt/zavod2
ExecStart=/opt/zavod2/docker/deploy.sh
# Сборка образа с нуля на четырёх ядрах занимает минуты.
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal
