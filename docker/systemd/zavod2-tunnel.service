# Обратный SSH-туннель мини-ПК → VPS: через него сайт виден клиентам VPN.
#
# Почему туннель, а не пир WireGuard на самом мини-ПК. Домашний IP
# динамический, но роли это не играет: соединение в обе стороны инициируется
# изнутри. Решило другое — у мини-ПК нет собственной учётки в VPN (в конфиге
# клиента Amnezia нет ни ключей, ни выданного адреса), и заводить её пришлось
# бы правкой awg0.conf внутри контейнера, который переписывает приложение
# Amnezia при добавлении клиентов. Туннель не зависит ни от того, ни от
# другого и вообще не трогает сеть мини-ПК — то есть не может задеть раннеры
# организации на этой же машине.
#
# Адрес 172.29.172.1 — мост docker на VPS, к которому подключён контейнер
# AmneziaWG. Он доступен и пирам VPN (телефон), и домашним машинам, чей
# трафик роутер заворачивает в туннель, но недоступен из интернета: на ens1
# порт не слушается вовсе. Проверено: с 195.26.230.225:8080 соединения нет.

[Unit]
Description=Zavod2: обратный туннель до VPS (доступ к фабрике из VPN)
After=network-online.target
Wants=network-online.target

[Service]
User=oem
Group=oem

# ExitOnForwardFailure обязателен. Без него ssh при занятом порте на той
# стороне остаётся жив и молча ничего не пробрасывает: systemd считает, что
# всё хорошо, а сайт недоступен. С ним процесс падает и Restart поднимает его
# заново — уже после того, как sshd на VPS прибьёт зависшую сессию по
# ClientAlive.
#
# ServerAlive — про смену домашнего IP: TCP-сессия при этом умирает молча, и
# без проб туннель висел бы мёртвым до перезагрузки.
#
# 7860 — сам сайт. 5100-5109 — dev-серверы игр («Играть»): без них с телефона
# открывался бы интерфейс, но не запущенная игра.
ExecStart=/usr/bin/ssh -N \
    -o BatchMode=yes \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -o TCPKeepAlive=yes \
    -o StrictHostKeyChecking=yes \
    -R 172.29.172.1:8080:127.0.0.1:7860 \
    -R 172.29.172.1:5100:127.0.0.1:5100 \
    -R 172.29.172.1:5101:127.0.0.1:5101 \
    -R 172.29.172.1:5102:127.0.0.1:5102 \
    -R 172.29.172.1:5103:127.0.0.1:5103 \
    -R 172.29.172.1:5104:127.0.0.1:5104 \
    -R 172.29.172.1:5105:127.0.0.1:5105 \
    -R 172.29.172.1:5106:127.0.0.1:5106 \
    -R 172.29.172.1:5107:127.0.0.1:5107 \
    -R 172.29.172.1:5108:127.0.0.1:5108 \
    -R 172.29.172.1:5109:127.0.0.1:5109 \
    tunnel@195.26.230.225

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
